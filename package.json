{
	"name": "ldr-obsidian-reader",
	"version": "0.1.0",
	"description": "Minimal epub reader plugin for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"epub",
		"reader"
	],
	"author": "LDR_Dev",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0"
	},
	"dependencies": {
		"epubjs": "^0.3.93",
		"jszip": "^3.10.1",
		"pdfjs-dist": "^3.11.174"
	}
}
